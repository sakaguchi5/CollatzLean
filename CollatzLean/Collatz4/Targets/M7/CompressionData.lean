    compressionRepresentativeNTable.size = compressionRepresentativeCount := by
  decide

theorem compressionRepresentativeTTable_size :
    compressionRepresentativeTTable.size = compressionRepresentativeCount := by
  decide

theorem compressionClassTable_size :
    compressionClassTable.size = candidateCount := by
  native_decide

theorem compressionMergeTimeTable_size :
    compressionMergeTimeTable.size = candidateCount := by
  native_decide

/-- 代表 `r` の開始指数。 -/
def compressionRepresentativeN
    (r : Fin compressionRepresentativeCount) : ℕ :=
  compressionRepresentativeNTable[r.1]!

/-- 候補 `i` の class 番号。 -/
def compressionClassNat (i : Fin candidateCount) : ℕ :=
  compressionClassTable[i.1]!

/-- 候補 `i` と代表が同期合流する certificate 時刻。 -/
def compressionMergeTime (i : Fin candidateCount) : ℕ :=
  compressionMergeTimeTable[i.1]!

/-- class table はすべて 0..96 に収まる。 -/
theorem compressionClassNat_lt :
    ∀ i : Fin candidateCount,
      compressionClassNat i < compressionRepresentativeCount := by
  native_decide

/-- 候補に対応する 97 代表。 -/
def compressionRepresentativeOf
    (i : Fin candidateCount) : Fin compressionRepresentativeCount :=
  ⟨compressionClassNat i, compressionClassNat_lt i⟩

/-- 全代表開始指数は共通終端時刻より前にある。 -/
theorem compressionRepresentativeN_le_target :
    ∀ r : Fin compressionRepresentativeCount,
      compressionRepresentativeN r ≤ targetTime := by
  native_decide

/--
97 代表の保存された `v₂` 値は互いに異なる。

したがって後で実軌道との一致を証明すれば、97代表終点も互いに異なる。
-/
theorem compressionRepresentativeTTable_nodup :
    compressionRepresentativeTTable.toList.Nodup := by
  native_decide

